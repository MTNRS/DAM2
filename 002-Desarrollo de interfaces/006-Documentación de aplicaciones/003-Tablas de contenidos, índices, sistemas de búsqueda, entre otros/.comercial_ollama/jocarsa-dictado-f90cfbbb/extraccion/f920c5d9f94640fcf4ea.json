    "usuarios": "Usuario general",
    "confianza": "verificada",
    "evidencia": "$('audio-forward').onclick=()=>{const a=$('playback');if(Number.isFinite(a.duration))a.currentTime=Math.min(a.duration,a.currentTime+5)}; $('audio-back').onclick=()=>{$('playback').currentTime=Math.max(0,$('playback').currentTime-5)};",
    "archivo": "static/app.js",
    "fragmento": 2
  },
